{
  "name": "contributte/invoice",
  "description": "Library for easily and quickly creating invoices for customers.",
  "keywords": ["contributte", "invoice"],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/contributte/invoice",
  "authors": [
    {
      "name": "Milan Felix Šulc",
      "homepage": "https://f3l1x.io"
    }
  ],
  "require": {
    "php": ">=8.2",
    "webchemistry/svg-pdf": "^1.1.3"
  },
  "require-dev": {
    "contributte/phpstan": "~0.2.0",
    "contributte/qa": "~0.4.0",
    "contributte/tester": "~0.3.0",
    "nette/application": "^3.0.0",
    "nette/di": "^3.0.0"
  },
  "autoload": {
    "psr-4": {
      "Contributte\\Invoice\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "5.1.x-dev"
    }
  }
}
